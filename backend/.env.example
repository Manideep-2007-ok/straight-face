# Copy to .env and fill in. .env is git-ignored. Never commit real values.
PORT=4000
NODE_ENV=development
# MongoDB Atlas connection string (Render calls this env var dbURL too)
dbURL=
# Database name inside the cluster
DB_NAME=straightface
# Any long random string, at least 16 characters
JWT_SECRET=
# Frontend URL, no trailing slash
CLIENT_URL=http://localhost:5173
# TURN relay (free provider), used by GET /api/rtc/ice in S3
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
